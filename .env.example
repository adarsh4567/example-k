ADMIN_JWT_EXPIRES_IN=8h
OTP_EXPIRY_MINUTES=5
OTP_RESEND_COOLDOWN_SECONDS=30
OTP_MAX_ATTEMPTS=5
SMS_MODE=mock
MOCK_OTP=123456
PAYMENT_MODE=mock
PAYMENT_FORCE_FAIL=0
PLATFORM_COMMISSION_PERCENT=20
CLOUDINARY_MODE=mock
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_DELIVERY_URL_TTL_SECONDS=3600
VIDEO_MAX_BYTES=209715200
AADHAAR_MODE=mock
FACE_MATCH_MODE=mock
PLACES_MODE=mock
WHATSAPP_MODE=mock
PAYOUT_MODE=mock
SLOW_REQUEST_MS=500
JSON_BODY_LIMIT=100kb
FORM_BODY_LIMIT=100kb
